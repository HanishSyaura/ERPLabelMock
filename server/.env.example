# Copy to .env. Placeholders only - never commit real secrets.
NODE_ENV=development
PORT=3000
# Local Docker database (npm run db:up). User/password match docker-compose.yml defaults.
DATABASE_URL=mysql://label_mes:label_mes_dev_pw@127.0.0.1:3306/label_mes_dev
# Backend tests TRUNCATE tables in this database - its name must end with _test.
TEST_DATABASE_URL=mysql://label_mes:label_mes_dev_pw@127.0.0.1:3306/label_mes_test
DATABASE_POOL_MAX=10
# Long random string (at least 32 characters). Mixed into every password hash.
PASSWORD_PEPPER=change-me-to-a-long-random-string-0000
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=120
COOKIE_SECURE=false
# Comma-separated browser origins allowed to call the API (Vite dev proxies, so usually empty).
CORS_ORIGINS=
LOG_LEVEL=info
UPLOAD_DIR=./storage/uploads
# Largest artwork upload in MB (PDF, AI, EPS, SVG, PNG, JPG).
ARTWORK_MAX_MB=50
# DEV ONLY (npm --workspace server run db:seed:dev): password of the dev.* role test accounts.
DEV_ACCOUNT_PASSWORD=
# Sign-in attempts allowed per IP address per 5 minutes.
LOGIN_IP_MAX_ATTEMPTS=30
