{
  "name": "@label-mes/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "npm run db:generate && tsc --noEmit && esbuild src/index.ts src/cli/*.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outdir=dist --sourcemap",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "npm run db:generate && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env src/cli/seed.ts",
    "db:seed:dev": "tsx --env-file=.env src/cli/seed-dev.ts",
    "db:seed:demo": "tsx --env-file=.env src/cli/seed-demo.ts",
    "housekeeping": "tsx --env-file=.env src/cli/housekeeping.ts",
    "bootstrap:admin": "tsx --env-file=.env src/cli/bootstrap-admin.ts"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "argon2": "^0.45.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mariadb": "^3.5.5",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "pino-pretty": "^13.2.0",
    "prisma": "^7.10.1",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "5.9",
    "vitest": "^5.1.1"
  }
}
